{
  "name": "eventcrowd-dbms-level3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed.sql",
    "db:setup": "node scripts/setup.mjs",
    "worker": "node scripts/outbox-worker.mjs",
    "test:integration": "node --import tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.10",
    "mongodb": "^6.15.0",
    "next": "^16.4.4",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
